# Required for the admin CMS
NEXLIVE_ADMIN_SECRET=replace-with-a-long-random-secret

# Cloudflare KV REST API configuration (server-side only)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_KV_NAMESPACE_ID=your-kv-namespace-id
CLOUDFLARE_API_TOKEN=token-with-kv-read-write-permission

# Optional sports provider key
SPORTS_API_KEY=
