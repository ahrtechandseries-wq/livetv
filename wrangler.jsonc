{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "nexlive",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{"binding":"WORKER_SELF_REFERENCE","service":"nexlive"},{"binding":"RESPONSE_STORE","service":"nexlive-response-store","entrypoint":"ResponseStoreService"}],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
,
  "version_metadata": {"binding":"CF_VERSION_METADATA"}
,
  "cache": {"enabled":false}
}
