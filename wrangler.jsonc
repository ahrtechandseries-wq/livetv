{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexlive",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
